# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY. Do not deploy this application to the public
# internet. See README.md "Local-only warning" for details.
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real secrets before running
# `docker compose up` or `npm run dev`. Never commit `.env`.

NODE_ENV=development

# Public base URL the app is served from. Used for cookie scoping, CSRF
# origin checks and CSP frame-ancestors.
APP_URL=http://localhost:3000

# Set to "true" only if you are serving over HTTPS locally. Leave "false"
# for plain http://localhost.
COOKIE_SECURE=false

# Session lifetime before a player must log in again.
SESSION_TTL_HOURS=12

# --- PostgreSQL server (docker-compose "db" service) ------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=security_training

# Superuser/owner credentials. ONLY used for running migrations and for the
# docker-entrypoint-initdb.d bootstrap script that creates the least-privilege
# application roles below. The running web app never uses this account.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser_password

# Least-privilege role used by the Next.js app for everything EXCEPT the
# SQL-injection challenge (users, sessions, progress, IDOR world data, XSS
# messages). Has no access to the sqli_challenge schema.
APP_DB_USER=app_role
APP_DB_PASSWORD=change_me_app_role_password

# Least-privilege role used ONLY by the SQL-injection challenge endpoint.
# Can SELECT from sqli_challenge.items alone (RLS-scoped to the current
# player) and has no grants on public.users, public.sessions, or any other
# player's data.
SQLI_DB_USER=sqli_role
SQLI_DB_PASSWORD=change_me_sqli_role_password

# How long a stored-XSS "render token" (used by the sandboxed iframe /
# server callback) stays valid before it must be re-issued.
XSS_RENDER_TOKEN_TTL_MINUTES=5
